# backend/.env.test.example — copy to backend/.env.test and fill in.
# Use a SEPARATE Supabase project (never the production one).
SUPABASE_URL=https://<test-project>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
SUPABASE_ANON_KEY=<anon-key>
GOOGLE_API_KEY=test-key-not-used-in-integration-tests
PLAID_CLIENT_ID=test
PLAID_SECRET=test
PLAID_ENV=sandbox
FRONTEND_URL=http://localhost:5173
