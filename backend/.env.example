SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Offline tooling only. App users save their own Gemini keys in Settings.
GOOGLE_API_KEY=
# Offline workflow only; export in the CLI process environment. Never commit real keys.
OPENROUTER_API_KEY=
# Enable only after applying both 20261011 advisor/transfer evidence migrations.
EVIDENCE_ADVISOR_ENABLED=false
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox
FRONTEND_URL=http://localhost:5173


# Eval harness (only set when running Spec A/B/C tests; never in prod)
EVAL_MOCKS=0

# Backend-only encryption. Generate keys locally; never commit real values.
PROVIDER_KEYS_ENCRYPTION_KEYS=
PROVIDER_KEYS_ACTIVE_VERSION=v1
